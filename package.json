{
  "name": "jev-emoji",
  "version": "0.2.0",
  "description": "Pick an emoji for a piece of text using TypeSafe's Jev model — curated or every Unicode emoji",
  "keywords": [
    "emoji",
    "jev",
    "typesafe",
    "classification",
    "llm"
  ],
  "author": "D C P Revere <dcprevere@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DCPRevere/jev-emoji.git"
  },
  "homepage": "https://github.com/DCPRevere/jev-emoji#readme",
  "bugs": {
    "url": "https://github.com/DCPRevere/jev-emoji/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test",
    "test:live": "node --env-file=.env --test test/live.test.js",
    "prepublishOnly": "npm test",
    "build:emojis": "node scripts/build-full-emojis.js"
  },
  "license": "MIT",
  "sideEffects": false
}
